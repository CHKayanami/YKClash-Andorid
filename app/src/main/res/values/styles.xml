<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4E6B3C</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F0F2EE</item>
        <item name="android:navigationBarColor">#F0F2EE</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B0D397</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#121510</item>
        <item name="android:navigationBarColor">#121510</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
